# Ignore everything by default
*

# Track these files and directories
!.gitignore
!README.md
!INSTALL.md
!requirements.txt

# Demos
!generate_demo_flux.py
!generate_demo_sd3.py
!collect_data_demo_flux.py

# Dataset collection + classifier training pipeline
!generate_dataset_flux.py
!generate_dataset_sd3.py
!label_mask2former.py
!label_blip.py
!label_merge.py
!feature_extract.py
!train_classifier_multi_object_real.py

# Generation + evaluation
!generate_geneval_flux.py
!generate_geneval_sd3.py
!generate_compbench_flux.py
!generate_compbench_sd3.py
!evaluate_geneval.py
!evaluate_aesthetic.py

# Stage runner scripts
!scripts/
!scripts/*.sh

# Data assets (object class list, README thumbnail)
!assets/
!assets/*.txt
!assets/thumbnail.png

# Benchmark overlay files (upstream repos are cloned separately, see benchmark_patches/README.md)
!benchmark_patches/
!benchmark_patches/**

# Pretrained classifiers
!classifier_ckpt/
!classifier_ckpt/*/
!classifier_ckpt/**

# Custom pipeline modules
!flux_osi_modules/
!flux_osi_modules/*.py

!sd3_osi_modules/
!sd3_osi_modules/*.py

